on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

# /dev/block/by-name is prepared by init.recovery.s5e8835.rc before this file
# is imported. These mounts are deliberately non-blocking: a missing EFS node
# must not prevent the recovery UI or ADB from starting.
on fs
    mount ext4 /dev/block/by-name/efs /mnt/vendor/efs nosuid nodev noatime noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic
    mount ext4 /dev/block/by-name/sec_efs /efs nosuid nodev noatime noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic
    mkdir /dev/socket/iwt 0770 system system
    mkdir /dev/socket/iwt/ca 0770 system system

# Preserve the vendor KeyMint setup actions without importing the stock
# service rc files, which started KeyMint/Gatekeeper before TEEGRIS was ready.
on post-fs
    mkdir /mnt/vendor/efs/DAK 0775 system system
    restorecon --recursive --force /mnt/vendor/efs/DAK
    chown system system /mnt/vendor/efs/DAK/gakkeybox
    chmod 0644 /mnt/vendor/efs/DAK/gakkeybox

on post-fs-data
    mkdir /data/vendor/tee 0700 system system
    mkdir /data/vendor/keymaster 0775 system system
    mkdir /data/vendor/gatekeeper 0770 system system

# Start secure-world services only after the real vendor TAs have been
# validated and the previous daemon has reported readiness.
on property:hwservicemanager.ready=true && property:crypto.ready=1
    start tz_service

on property:vendor.tzdaemon=Ready
    setprop vendor.TEEGRIS.loaded true
    write /proc/iccc_ready 1
    start tzts_service

on property:vendor.tzts_daemon=Ready
    start vendor.keymint-default
    start vendor.gatekeeper-1-0
    start vendor.fkeymaster-default

on property:twrp.all.users.decrypted=true
    stop tz_service
    stop tzts_service
    stop vendor.keymint-default
    stop vendor.gatekeeper-1-0
    stop vendor.fkeymaster-default
    umount /mnt/vendor/efs
    umount /efs

service tz_service /vendor/bin/tzdaemon
    override
    user system
    group system readproc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

service tzts_service /vendor/bin/tzts_daemon
    override
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

service vendor.keymint-default /vendor/bin/hw/android.hardware.security.keymint-service
    override
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    override
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user system
    group system 5678
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

service vendor.fkeymaster-default /vendor/bin/vendor.samsung.hardware.security.fkeymaster-service
    override
    interface aidl vendor.samsung.hardware.security.fkeymaster.ISehFkeymaster/default
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0
